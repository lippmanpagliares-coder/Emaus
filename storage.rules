rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anexos dos materiais de estudo: só quem está logado pode enviar,
    // baixar ou remover arquivos.
    match /materiais/{materialId}/{arquivo} {
      allow read, write: if request.auth != null;
    }

    // Fotos e arquivos anexados a posts da Comunidade.
    match /comunidade/{arquivo} {
      allow read, write: if request.auth != null;
    }
  }
}
