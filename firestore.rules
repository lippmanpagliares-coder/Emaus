rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só pode escrever no próprio perfil, mas pode ler o perfil de
    // qualquer um (necessário para a catequista ver a turma e para o aviso de
    // aniversário na Comunidade).
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A lista de turmas (nome + código de convite) pode ser lida por qualquer
    // pessoa, mesmo antes de logar — é assim que a tela de cadastro confere o
    // código da turma antes de criar a conta. Só quem já está logado pode
    // criar/editar turmas.
    match /turmas/{turmaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /turmaData/{turmaId} {
      allow read, write: if request.auth != null;
    }

    // Cache diário da liturgia (referências das leituras + santo do dia,
    // extraídos 1x por dia da Minha Biblioteca Católica). Sem dado sensível.
    match /liturgiaCache/{dataChave} {
      allow read, write: if request.auth != null;
    }
  }
}
